#!/bin/sh
# This repository is public: a push publishes every commit it carries. Scan the tree and every
# commit between the remote's current tip and what is being pushed; any hit stops the push.
set -eu
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  base="$remote_sha"
  [ "$base" = "$zero" ] && base=origin/main
  node "$root/scripts/leak-gate.mjs" --base "$base" --head "$local_sha" || status=1
done
exit $status
